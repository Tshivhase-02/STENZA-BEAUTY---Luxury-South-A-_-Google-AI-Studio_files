# Google Gemini API Key for Beauty Concierge AI
GEMINI_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development

# Admin Authentication Development Mode
# Set to 'true' to allow temporary access with any non-empty username & password during local development.
# Set to 'false' to require standard admin credentials.
# NOTE: Automatically disabled in production (NODE_ENV=production).
ADMIN_DEMO_MODE=true
